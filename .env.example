# Переименуй этот файл в .env и заполни значения

# Discord Bot Token
# Получить: https://discord.com/developers/applications → твой бот → Bot → Token
DISCORD_TOKEN=token

# Hugging Face Token (нужен для pyannote/speaker-diarization-3.1)
# Получить: https://huggingface.co/settings/tokens
# После получения токена — прими условия использования модели:
# https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=token
