# Переименуй этот файл в .env и заполни значения

# Discord Bot Token
# Получить: https://discord.com/developers/applications → твой бот → Bot → Token
DISCORD_TOKEN=token

# Hugging Face Token (нужен для pyannote/speaker-diarization-3.1)
# Получить: https://huggingface.co/settings/tokens
# После получения токена — прими условия использования модели:
# https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=token

# LLM post-processing (optional — requires ollama running locally)
# LLM_MODEL=qwen2.5:7b
# LLM_BATCH_SIZE=40       # segments per LLM request; reduce if context window overflows

# Language detection
# LANG_SWITCH_THRESHOLD=5  # consecutive segments in new language before committing a switch
#                           # lower = more sensitive to code-switching; higher = more stable
